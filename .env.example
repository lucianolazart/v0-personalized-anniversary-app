# Copiá este archivo a .env.local y pegá tu API Key de TMDB.
# 1. Creá una cuenta en https://www.themoviedb.org/signup
# 2. Pedí la clave gratis en Settings → API
# 3. Reiniciá el servidor de Next.js después de guardarla
TMDB_API_KEY=

# Notificaciones push (ver README). Generá el par con: npx web-push generate-vapid-keys
# En producción van en Vercel → Settings → Environment Variables (y redeploy).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional: mailto:tu@mail o https://tu-dominio
VAPID_SUBJECT=
# Opcional: protege /api/movie-night/reminders. Vercel lo manda solo en las llamadas del cron.
CRON_SECRET=
